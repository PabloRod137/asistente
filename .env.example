# Identidad del negocio
APP_NAME=Nombre del negocio
VERIFY_TOKEN=token_secreto_unico_por_cliente

# Clave secreta de la app de Meta Developers para validar la firma HMAC de los webhooks
# entrantes (Configuración básica de tu app en Meta for Developers -> "Clave secreta de la app").
# Sin esto, el servidor rechaza CUALQUIER webhook con error 500 (falla de forma segura).
META_APP_SECRET=

# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Gemini
GEMINI_API_KEY=

# Calendario
CALENDAR_TIPO=outlook            # google | outlook | simulado
CITA_DURACION_MINUTOS=60
GOOGLE_CREDENTIALS_JSON=credentials.json

# Integración Microsoft 365 / Graph API (Unificada para SharePoint, Outlook y Calendario)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
MS_DRIVE_ID=                     # Opcional, si no se usa el drive por defecto del site

# Almacenamiento (local | sharepoint)
STORAGE_TIPO=local
STORAGE_RUTA=./storage
DB_PATH=chatbot.db
SHAREPOINT_CARPETA_FACTURAS=facturas_emitidas
SHAREPOINT_CARPETA_TICKETS=gastos_clientes

# Envío de Emails (smtp | graph)
EMAIL_TIPO=smtp

# Facturación
FACTURA_EMISOR_NOMBRE=
FACTURA_EMISOR_CIF=
FACTURA_EMISOR_DIRECCION=
FACTURA_EMISOR_IBAN=

# Notificaciones profesional
PROFESIONAL_WHATSAPP=
PROFESIONAL_EMAIL=
EMAIL_EMISOR=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Módulos activos (true/false)
MODULO_AGENDA=true
MODULO_TICKETS=true
MODULO_FACTURAS=true
MODULO_TRIAJE=true
MODULO_COBRADOR=true
MODULO_RESUMEN=true
MODULO_MEMORIA=true
MODULO_ESCALADO=true

# Resumen de conversaciones
CONVERSACION_TIMEOUT_MINUTOS=30
GESTOR_EMAIL=
TEAMS_WEBHOOK_URL=       # URL del Incoming Webhook del canal de Teams
GESTOR_WHATSAPP=          # Número del gestor en formato internacional sin + (ej: 34612345678)

# Secretaria interna
BRIEFING_HORA=09:00          # Hora del briefing diario (formato HH:MM)
MODULO_SECRETARIA=true

# Entorno de ejecución ('produccion'/'production' bloquea el arranque si MODO_TEST=true)
ENTORNO=desarrollo
# Activa datos simulados en vez de extracción real con Gemini (NUNCA en producción)
MODO_TEST=false

# Encaminamiento de escalados por especialidad (JSON: especialidad -> whatsapp del gestor).
# Si no se define, todo escalado usa GESTOR_WHATSAPP como fallback genérico.
# Ejemplo: {"fiscal":"34611111111","laboral":"34622222222","mercantil":"34633333333"}
GESTORES_POR_ESPECIALIDAD=

# Importe máximo permitido al extraer una factura automáticamente antes de pedir confirmación manual
FACTURA_LIMITE_MAXIMO=50000.0

# Recordatorios automáticos (documentos pendientes y plazos fiscales)
RECORDATORIOS_HORA=09:00
RECORDATORIO_DOCUMENTOS_DIAS_ANTES=3
RECORDATORIO_FISCAL_DIAS_ANTES=7

# Minutos de inactividad tras los que se dispara el auto-resumen de una conversación
# (variable DISTINTA de CONVERSACION_TIMEOUT_MINUTOS de arriba, que solo cuenta "nueva visita")
TIMEOUT_INACTIVIDAD_MINUTOS=15
